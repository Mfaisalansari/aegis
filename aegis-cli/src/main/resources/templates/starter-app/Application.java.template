package {{PACKAGE}};

import com.aegis.api.AegisApplication;
import com.aegis.api.AegisConfig;
import com.aegis.api.AegisConfigLoader;

import java.nio.file.Path;

/**
 * Everything application-specific lives in application.yml — this class
 * just points at it. Generated by `aegis init`; edit application.yml to
 * describe your own app, or switch to an environments:/missions:
 * enterprise config (see AEGIS's USAGE.md §8c) once you have more than one.
 */
public class {{APP_NAME}}Application implements AegisApplication {

    @Override
    public String name() {
        return "{{APP_NAME}}";
    }

    @Override
    public AegisConfig config() {
        return AegisConfigLoader.load(Path.of("application.yml"));
    }
}
